# ============================================================
# THINK IT. SEE IT. — Environment Configuration
# ============================================================
# Copy this file to .env.local and fill in your values.
#
# The app works WITHOUT any API key (demo mode with curated mock data).
# Add a Claude or OpenAI key to enable live AI-powered generation.
# Claude is preferred — set ANTHROPIC_API_KEY and it will be used first.

# Anthropic Claude API Key (recommended — better at strategic/creative writing)
# Get yours at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI API Key (fallback if no Anthropic key)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
